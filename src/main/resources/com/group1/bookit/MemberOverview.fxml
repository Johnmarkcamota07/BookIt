<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      id="memberOverviewPage" spacing="22.0" minWidth="0.0" prefWidth="760.0"
      styleClass="member-overview-page" stylesheets="@bookit-dashboard.css">
    <fx:define>
        <Label fx:id="overviewEmptyLoansLabel" text="You have no current loans."
               wrapText="true" styleClass="muted"/>
    </fx:define>
    <children>
        <VBox id="overviewHero" spacing="16.0" minWidth="0.0" maxWidth="1.7976931348623157E308"
              styleClass="section-card, hero-card">
            <children>
                <Label text="Find your next good read" wrapText="true" minHeight="-Infinity" styleClass="section-title"/>
                <Label text="Explore the catalog, keep track of your books, and plan your next visit."
                       wrapText="true" minHeight="-Infinity" styleClass="muted"/>
                <HBox spacing="18.0" alignment="TOP_LEFT" fillHeight="true">
                    <children>
                        <Button fx:id="overviewExploreCatalog" text="Explore the catalog" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="primary-button"/>
                        <Button fx:id="overviewViewLoans" text="View my loans" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="secondary-button"/>
                        <Button fx:id="overviewRefresh" text="Refresh" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="secondary-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <HBox id="overviewStats" spacing="18.0" alignment="TOP_LEFT" fillHeight="true">
            <children>
                <VBox spacing="10.0" minWidth="0.0" prefWidth="220.0" maxWidth="1.7976931348623157E308"
                      HBox.hgrow="ALWAYS" styleClass="stat-card, accent-blue">
                    <children>
                        <Label text="MY ACTIVE LOANS" wrapText="true" minHeight="-Infinity" styleClass="stat-label"/>
                        <Label fx:id="overviewActiveLoans" wrapText="true" minHeight="-Infinity" styleClass="stat-value"/>
                        <Label text="Unreturned copies on your account" wrapText="true" minHeight="-Infinity" styleClass="stat-detail"/>
                    </children>
                </VBox>
                <VBox spacing="10.0" minWidth="0.0" prefWidth="220.0" maxWidth="1.7976931348623157E308"
                      HBox.hgrow="ALWAYS" styleClass="stat-card, accent-orange">
                    <children>
                        <Label text="OVERDUE" wrapText="true" minHeight="-Infinity" styleClass="stat-label"/>
                        <Label fx:id="overviewOverdueLoans" wrapText="true" minHeight="-Infinity" styleClass="stat-value"/>
                        <Label text="Open loans past their due time" wrapText="true" minHeight="-Infinity" styleClass="stat-detail"/>
                    </children>
                </VBox>
                <VBox spacing="10.0" minWidth="0.0" prefWidth="220.0" maxWidth="1.7976931348623157E308"
                      HBox.hgrow="ALWAYS" styleClass="stat-card, accent-green">
                    <children>
                        <Label text="AVAILABLE TITLES" wrapText="true" minHeight="-Infinity" styleClass="stat-label"/>
                        <Label fx:id="overviewAvailableTitles" wrapText="true" minHeight="-Infinity" styleClass="stat-value"/>
                        <Label text="Catalog titles with an available copy" wrapText="true" minHeight="-Infinity" styleClass="stat-detail"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <VBox id="overviewCurrentLoans" spacing="16.0" minWidth="0.0" maxWidth="1.7976931348623157E308"
              styleClass="section-card">
            <children>
                <Label text="Your current loans" wrapText="true" minHeight="-Infinity" styleClass="section-title"/>
                <Label fx:id="overviewLoansSubtitle" wrapText="true" minHeight="-Infinity" styleClass="muted"/>
                <VBox fx:id="overviewLoansHost" minWidth="0.0"/>
                <Button fx:id="overviewHistory" text="See borrowing history" mnemonicParsing="false"
                        maxWidth="-Infinity" styleClass="secondary-button"/>
            </children>
        </VBox>
        <Label text="Reserve titles from the catalog, manage requests in Reservations, and check recorded balances in My fines. Update your contact details or generate a personal QR from My profile &amp; QR."
               wrapText="true" minHeight="-Infinity" styleClass="section-note"/>
    </children>
</VBox>

