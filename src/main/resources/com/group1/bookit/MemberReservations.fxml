<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      id="memberReservationsPage" spacing="22.0" minWidth="0.0" prefWidth="760.0"
      stylesheets="@bookit-dashboard.css">
    <fx:define>
        <Label fx:id="memberReservationEmpty" text="You have no reservation history." wrapText="true" styleClass="muted"/>
        <Label fx:id="memberReservationNoMatches" text="No reservations match your search." wrapText="true" styleClass="muted"/>
    </fx:define>
    <children>
        <VBox id="memberReservationsSection" spacing="16.0" minWidth="0.0" maxWidth="1.7976931348623157E308" styleClass="section-card">
            <children>
                <Label text="Your reservation queue and history" wrapText="true" minHeight="-Infinity" styleClass="section-title"/>
                <Label fx:id="memberReservationSubtitle" wrapText="true" minHeight="-Infinity" styleClass="muted"/>
                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="memberReservationSearch" promptText="Search your reservations…"
                                   accessibleText="Search your reservation history by title, request ID, or status"
                                   HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button fx:id="memberReservationRefresh" text="Refresh" mnemonicParsing="false" maxWidth="-Infinity" styleClass="secondary-button"/>
                    </children>
                </HBox>
                <Label fx:id="memberReservationCount" wrapText="true" minHeight="-Infinity" styleClass="muted"/>
                <VBox fx:id="memberReservationTableHost" minWidth="0.0"/>
                <HBox spacing="18.0" alignment="TOP_LEFT" fillHeight="true">
                    <children>
                        <Button fx:id="memberReservationCancel" text="Cancel reservation" disable="true" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="secondary-button"/>
                        <Button fx:id="memberReservationBrowse" text="Browse the catalog" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="secondary-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <Label text="PENDING and READY requests are active. Queue positions count all active requests for the title, ordered by request time and reservation ID. Completed requests have no position. READY does not reserve a physical copy; ask the library desk about collection."
               wrapText="true" minHeight="-Infinity" styleClass="section-note"/>
    </children>
</VBox>

