<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12.0" alignment="CENTER" minHeight="160.0"
      styleClass="empty-state" stylesheets="@bookit-dashboard.css">
    <children>
        <Label fx:id="emptyTitle" wrapText="true" styleClass="section-title"/>
        <Label fx:id="emptyDetail" wrapText="true" styleClass="muted"/>
    </children>
</VBox>

