<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group1.bookit.BarcodeScannerDialog"
      prefWidth="680.0" prefHeight="510.0" spacing="14.0"
      styleClass="barcode-scanner"
      stylesheets="@barcode-scanner.css">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <children>
        <Label text="Book copy barcode" styleClass="scanner-title"/>
        <Label text="Show the CODE 128 label on the physical book copy. Keep the entire barcode and both ends visible."
               wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="scanner-instruction"/>
        <StackPane fx:id="previewFrame" minWidth="0.0" minHeight="210.0"
                   prefWidth="640.0" prefHeight="300.0" VBox.vgrow="ALWAYS"
                   styleClass="scanner-preview-frame">
            <clip>
                <Rectangle fx:id="previewClip" arcWidth="24.0" arcHeight="24.0"/>
            </clip>
            <children>
                <ImageView fx:id="preview" fitHeight="0.0" preserveRatio="true" smooth="true"/>
            </children>
        </StackPane>
        <Label fx:id="status" text="Opening camera..." wrapText="true" minHeight="-Infinity" styleClass="scanner-status"/>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="cancel" text="Cancel" cancelButton="true" onAction="#handleCancel"/>
            </children>
        </HBox>
    </children>
</VBox>

