<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group1.bookit.QRreaderController"
            prefWidth="640.0" prefHeight="480.0" styleClass="qr-reader" stylesheets="@qr-reader.css">
    <center>
        <VBox alignment="CENTER" spacing="10.0">
            <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
            <children>
                <Label text="BookIt QR Reader" minHeight="-Infinity" styleClass="qr-reader-title"/>
                <Label text="Place your saved BookIt login QR inside the square."
                       minHeight="-Infinity" styleClass="qr-reader-subtitle"/>
                <StackPane id="qrReaderFrame" minWidth="320.0" minHeight="320.0"
                           prefWidth="320.0" prefHeight="320.0" maxWidth="320.0" maxHeight="320.0"
                           styleClass="qr-reader-frame">
                    <clip><Rectangle width="320.0" height="320.0" arcWidth="18.0" arcHeight="18.0"/></clip>
                    <children>
                        <ImageView fx:id="cameraImage" fitWidth="320.0" fitHeight="320.0" preserveRatio="true"/>
                        <Rectangle id="qrReaderGuide" width="280.0" height="280.0" arcWidth="14.0" arcHeight="14.0"
                                   mouseTransparent="true" styleClass="qr-reader-guide"/>
                    </children>
                </StackPane>
                <Label fx:id="scanResultLabel" text="Opening camera..." alignment="CENTER" textAlignment="CENTER"
                       maxWidth="560.0" minHeight="36.0" prefHeight="36.0" wrapText="true" styleClass="qr-reader-status"/>
            </children>
        </VBox>
    </center>
</BorderPane>
