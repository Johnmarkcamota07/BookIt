<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group1.bookit.AdminDashboardController"
            fx:id="root"
            prefWidth="1240.0"
            prefHeight="820.0"
            minWidth="1024.0"
            minHeight="700.0"
            styleClass="app-root"
            stylesheets="@bookit-dashboard.css">
    <left>
        <VBox prefWidth="220.0" minWidth="220.0" maxWidth="220.0" styleClass="sidebar">
            <ImageView fx:id="sidebarLogo"
                        fitWidth="178.0"
                        fitHeight="145.0"
                        preserveRatio="true"
                        smooth="true">
                 <image>
                     <Image url="@images/logo2.png"/>
                 </image>
             </ImageView>
            <Label text="LIBRARY MANAGEMENT" styleClass="sidebar-caption"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="navigationBox" spacing="6.0"/>
                </content>
            </ScrollPane>
            <VBox spacing="6.0" styleClass="sidebar-footer">
                <Label fx:id="accountName" text="Administrator" wrapText="true" styleClass="sidebar-account"/>
                <Label fx:id="accountRole" text="ADMIN WORKSPACE" styleClass="sidebar-caption"/>
                <Button text="Log out" onAction="#handleLogout" maxWidth="Infinity"
                        styleClass="danger-button"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="workspace">
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle" text="Overview" styleClass="page-title"/>
                    <Label fx:id="pageSubtitle" text="Your library, at a glance."
                           wrapText="true" styleClass="page-subtitle"/>
                </VBox>
                <Label  fx:id="dataModeLabel"
                        text="NOT CONNECTED"
                        styleClass="offline-badge"/>
            </HBox>
            <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="pageContent" spacing="22.0" styleClass="page-content"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
