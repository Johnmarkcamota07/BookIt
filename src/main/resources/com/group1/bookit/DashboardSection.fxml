<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="16.0" minWidth="0.0" maxWidth="1.7976931348623157E308"
      styleClass="section-card" stylesheets="@bookit-dashboard.css">
    <children>
        <Label fx:id="sectionTitle" wrapText="true" styleClass="section-title"/>
        <Label fx:id="sectionSubtitle" wrapText="true" styleClass="muted"/>
    </children>
</VBox>

