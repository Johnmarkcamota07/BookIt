<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="10.0" minWidth="190.0" prefWidth="235.0" maxWidth="1.7976931348623157E308"
      styleClass="stat-card" stylesheets="@bookit-dashboard.css">
    <children>
        <Label fx:id="adminMetricTitle" wrapText="true" minHeight="-Infinity" styleClass="stat-label"/>
        <Label fx:id="adminMetricValue" wrapText="true" minHeight="-Infinity" styleClass="stat-value"/>
        <Label text="Current database snapshot" wrapText="true" minHeight="-Infinity" styleClass="stat-detail"/>
    </children>
</VBox>
