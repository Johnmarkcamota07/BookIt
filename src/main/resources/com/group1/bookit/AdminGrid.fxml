<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- Columns and rows remain generated from the service's runtime table schema. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      id="adminSearchGrid" spacing="16.0" minWidth="0.0" stylesheets="@bookit-dashboard.css">
    <children>
        <HBox spacing="16.0">
            <children>
                <TextField fx:id="adminGridSearch" HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Label fx:id="adminGridCount" wrapText="true" minHeight="-Infinity" styleClass="muted"/>
            </children>
        </HBox>
        <VBox fx:id="adminGridTableHost" minWidth="0.0"/>
    </children>
</VBox>
