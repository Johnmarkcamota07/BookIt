<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="16.0" stylesheets="@bookit-dashboard.css">
    <children>
        <HBox fx:id="searchToolbar" spacing="16.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchInput" prefWidth="360.0" maxWidth="500.0"
                           HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Label fx:id="searchCount" wrapText="true" styleClass="muted"/>
            </children>
        </HBox>
    </children>
</VBox>

