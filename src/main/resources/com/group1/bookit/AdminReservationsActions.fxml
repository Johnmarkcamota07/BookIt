<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.FlowPane?>

<FlowPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          hgap="12.0" vgap="12.0" styleClass="toolbar" stylesheets="@bookit-dashboard.css">
    <children>
        <Button fx:id="adminRefresh" text="Refresh" mnemonicParsing="false" maxWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="adminReservationReady" text="Mark ready" mnemonicParsing="false"
                maxWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="reservationConfirmPickup" text="Confirm pickup &amp; issue loan" mnemonicParsing="false"
                maxWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="adminReservationCancel" text="Cancel reservation" mnemonicParsing="false"
                maxWidth="-Infinity" styleClass="secondary-button"/>
    </children>
</FlowPane>
