<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      id="memberCatalogPage" spacing="22.0" minWidth="0.0" prefWidth="760.0"
      styleClass="member-catalog-page" stylesheets="@bookit-dashboard.css">
    <fx:define>
        <Label fx:id="catalogEmptyLabel" text="No books are recorded in the catalog." wrapText="true" styleClass="muted"/>
        <Label fx:id="catalogNoMatchesLabel" text="No books match your search and category." wrapText="true" styleClass="muted"/>
    </fx:define>
    <children>
        <VBox id="catalogSection" spacing="16.0" minWidth="0.0" maxWidth="1.7976931348623157E308" styleClass="section-card">
            <children>
                <Label text="Browse the shelves" wrapText="true" minHeight="-Infinity" styleClass="section-title"/>
                <Label text="Titles, authors, categories, and copy counts come from MySQL."
                       wrapText="true" minHeight="-Infinity" styleClass="muted"/>
                <HBox spacing="12.0" styleClass="toolbar">
                    <children>
                        <TextField fx:id="catalogSearch" promptText="Search title, author, ISBN, or book ID…"
                                   accessibleText="Search catalog by title, author, ISBN, or book ID"
                                   HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <ComboBox fx:id="catalogCategory" prefWidth="185.0" accessibleText="Filter books by category"/>
                        <Button fx:id="catalogRefresh" text="Refresh" mnemonicParsing="false" maxWidth="-Infinity"
                                styleClass="secondary-button"/>
                    </children>
                </HBox>
                <Label fx:id="catalogCount" wrapText="true" minHeight="-Infinity" styleClass="muted"/>
                <VBox fx:id="catalogTableHost" minWidth="0.0"/>
                <HBox spacing="18.0" alignment="TOP_LEFT" fillHeight="true">
                    <children>
                        <Button fx:id="catalogDetails" text="View book details" disable="true" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="secondary-button"/>
                        <Button fx:id="catalogReserve" text="Reserve selected book" disable="true" mnemonicParsing="false"
                                maxWidth="-Infinity" HBox.hgrow="ALWAYS" styleClass="primary-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <Label text="Select a title to reserve it, even when copies are currently available. Eligibility is checked when you confirm. A request joins the title queue; it does not hold a specific physical copy."
               wrapText="true" minHeight="-Infinity" styleClass="section-note"/>
    </children>
</VBox>

