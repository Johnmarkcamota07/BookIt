<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group1.bookit.AttendanceUnlockController"
      prefWidth="450.0" prefHeight="260.0" spacing="12.0" styleClass="attendance-unlock"
      stylesheets="@attendance-kiosk.css">
    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
    <children>
        <Label fx:id="heading" id="attendanceUnlockHeading" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="username" id="attendanceUnlockUsername" accessibleText="Administrator username"/>
        <PasswordField fx:id="password" id="attendanceUnlockPassword" promptText="Administrator password"
                       accessibleText="Administrator password"/>
        <Label fx:id="error" id="attendanceUnlockError" wrapText="true" minHeight="-Infinity"/>
        <HBox spacing="10.0">
            <children>
                <Button fx:id="verify" id="attendanceUnlockVerify" text="Verify administrator"
                        defaultButton="true" onAction="#verifyAdministrator"/>
                <Button fx:id="cancel" id="attendanceUnlockCancel" text="Cancel" onAction="#cancel"/>
            </children>
        </HBox>
    </children>
</VBox>
