<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.transform.Scale?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group1.bookit.BarcodeLabelDialog"
            prefWidth="690.0" prefHeight="700.0" styleClass="copy-label-dialog"
            stylesheets="@barcode-label.css">
    <fx:define>
        <Scale fx:id="previewScale" x="2.0" y="2.0" pivotX="0.0" pivotY="0.0"/>
    </fx:define>
    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="12.0" styleClass="label-dialog-content">
                    <padding>
                        <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
                    </padding>
                    <children>
                        <Label text="COPY BARCODE LABEL" wrapText="true" minHeight="-Infinity"
                               styleClass="label-dialog-caption"/>
                        <Label fx:id="bookTitle" id="barcodeBookTitle" wrapText="true" minHeight="-Infinity"
                               styleClass="label-dialog-title"/>
                        <Label fx:id="copyMetadata" id="barcodeCopyMetadata" wrapText="true" minHeight="-Infinity"
                               styleClass="label-dialog-muted"/>
                        <StackPane id="barcodeLabelPreview" minHeight="307.46456692913387"
                                   styleClass="label-dialog-preview">
                            <padding>
                                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                            </padding>
                            <children>
                                <Group fx:id="previewGroup"/>
                            </children>
                        </StackPane>
                        <Label text="Print size: 100 × 50 mm. One label per page; choose the number of copies in the print dialog. Select a printer or your system's Print-to-PDF destination."
                               wrapText="true" minHeight="-Infinity" styleClass="label-dialog-note"/>
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="print" id="barcodePrint" text="Print label / Save PDF"
                                        onAction="#printLabel" styleClass="label-dialog-primary-button"/>
                                <Button fx:id="save" id="barcodeSave" text="Save barcode PNG"
                                        onAction="#chooseSave" styleClass="label-dialog-secondary-button"/>
                            </children>
                        </HBox>
                        <Label text="Save barcode PNG exports the barcode image only (1200 × 240 pixels), without the title or shelf text."
                               wrapText="true" minHeight="-Infinity" styleClass="label-dialog-muted"/>
                        <Label fx:id="status" id="barcodeStatus"
                               text="Ready. This label uses the registered copy's exact stored barcode."
                               wrapText="true" minHeight="-Infinity" styleClass="label-dialog-muted"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10.0" right="22.0" bottom="16.0" left="22.0"/>
            </padding>
            <children>
                <Button fx:id="close" id="barcodeClose" text="Close" onAction="#handleClose"
                        styleClass="label-dialog-secondary-button"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>

