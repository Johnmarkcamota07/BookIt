<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="520.0" prefHeight="180.0" styleClass="attendance-feedback"
      stylesheets="@attendance-kiosk.css">
    <padding><Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/></padding>
    <children>
        <Label fx:id="feedbackMessage" id="attendanceFeedbackMessage" wrapText="true" minHeight="-Infinity"
               styleClass="attendance-feedback-message"/>
    </children>
</VBox>

