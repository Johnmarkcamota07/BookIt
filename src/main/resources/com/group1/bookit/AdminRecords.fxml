<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- Runtime data and selection actions are attached by AdminDashboardController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      id="adminRecordSection" spacing="16.0" minWidth="0.0" maxWidth="1.7976931348623157E308"
      styleClass="section-card" stylesheets="@bookit-dashboard.css">
    <children>
        <Label fx:id="adminRecordTitle" wrapText="true" minHeight="-Infinity" styleClass="section-title"/>
        <Label fx:id="adminRecordSubtitle" wrapText="true" minHeight="-Infinity" styleClass="muted"/>
        <VBox fx:id="adminRecordActions" minWidth="0.0"/>
        <VBox fx:id="adminRecordGrid" minWidth="0.0"/>
    </children>
</VBox>
