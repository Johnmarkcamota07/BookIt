<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group1.bookit.PasswordChangeDialog"
            prefWidth="570.0" prefHeight="650.0" styleClass="password-change-dialog"
            stylesheets="@password-change.css">
    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="16.0" styleClass="password-change-content">
                    <padding>
                        <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
                    </padding>
                    <children>
                        <Label text="Change password" wrapText="true" minHeight="-Infinity"
                               styleClass="password-change-title"/>
                        <Label fx:id="accountLabel" id="passwordAccount" wrapText="true" minHeight="-Infinity"
                               styleClass="password-change-muted"/>
                        <Label id="passwordRequirements"
                               text="Use 15 to 1,024 characters. Spaces are allowed and are not trimmed. Choose a password you do not use elsewhere."
                               wrapText="true" minHeight="-Infinity" styleClass="password-change-note"/>
                        <VBox id="passwordFields" spacing="8.0" styleClass="password-change-fields">
                            <padding>
                                <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
                            </padding>
                            <children>
                                <Label text="Current password" wrapText="true" minHeight="-Infinity"
                                       styleClass="password-change-muted"/>
                                <PasswordField fx:id="current" id="passwordCurrent" promptText="Current password"
                                               accessibleText="Current password"/>
                                <Label text="New password" wrapText="true" minHeight="-Infinity"
                                       styleClass="password-change-muted"/>
                                <PasswordField fx:id="next" id="passwordNew" promptText="At least 15 characters"
                                               accessibleText="New password, at least 15 characters"/>
                                <Label text="Confirm new password" wrapText="true" minHeight="-Infinity"
                                       styleClass="password-change-muted"/>
                                <PasswordField fx:id="confirmation" id="passwordConfirm" promptText="Enter the new password again"
                                               accessibleText="Confirm the new password"/>
                            </children>
                        </VBox>
                        <Label text="A successful change revokes your saved library QR and signs you out of this BookIt window. Sign in with the new password; members can then generate a new QR."
                               wrapText="true" minHeight="-Infinity" styleClass="password-change-note"/>
                        <Label fx:id="feedback" id="passwordFeedback" wrapText="true" minHeight="-Infinity"
                               styleClass="password-change-muted"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets top="12.0" right="22.0" bottom="18.0" left="22.0"/>
            </padding>
            <children>
                <Button fx:id="cancel" id="passwordCancel" text="Cancel" onAction="#requestClose"
                        styleClass="password-change-secondary-button"/>
                <Button fx:id="submit" id="passwordSubmit" text="Change password" onAction="#submit"
                        defaultButton="true" styleClass="password-change-primary-button"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>

