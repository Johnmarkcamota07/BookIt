<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane
    prefHeight="480.0"
    prefWidth="640.0"
    style="-fx-background-color: linear-gradient(to bottom right, #101827, #252344, #171c2b);"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.group1.bookit.PrimaryController">

    <children>
        <HBox
            alignment="CENTER"
            spacing="0.0"
            maxWidth="641.0"
            maxHeight="480.0"
            prefWidth="641.0"
            prefHeight="480.0">

            <children>
                <VBox
                    alignment="CENTER"
                    prefHeight="480.0"
                    prefWidth="370.0"
                    minWidth="370.0"
                    style="-fx-background-color: #171c2b;">

                    <padding>
                        <Insets
                            top="20.0"
                            right="10.0"
                            bottom="20.0"
                            left="10.0"/>
                    </padding>

                    <children>
                        <Label
                            prefHeight="190.0"
                            prefWidth="207.0"
                            text="Know your library inside out. BookIt."
                            textFill="WHITE"
                            wrapText="true">

                            <font>
                                <Font
                                    name="Bookman Old Style"
                                    size="39.0"/>
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox
                    alignment="TOP_CENTER"
                    prefHeight="480.0"
                    prefWidth="271.0"
                    minWidth="271.0"
                    style="-fx-background-color: #2b3043;">

                    <children>
                        <Label
                            alignment="CENTER"
                            contentDisplay="CENTER"
                            prefHeight="59.0"
                            prefWidth="210.0"
                            text="BookIt"
                            textAlignment="CENTER"
                            textFill="WHITE">

                            <font>
                                <Font
                                    name="Bookman Old Style Bold"
                                    size="60.0"/>
                            </font>

                            <VBox.margin>
                                <Insets top="20.0"/>
                            </VBox.margin>
                        </Label>

                        <Label
                            text=" Library Management and Tracking System"
                            textFill="WHITE"
                            wrapText="true"
                            alignment="CENTER">

                            <VBox.margin>
                                <Insets bottom="20.0"/>
                            </VBox.margin>
                        </Label>

                        <TextField
                            prefHeight="26.0"
                            prefWidth="226.0"
                            promptText="Username">

                            <VBox.margin>
                                <Insets
                                    bottom="20.0"
                                    left="20.0"
                                    right="20.0"
                                    top="20.0"/>
                            </VBox.margin>

                            <font>
                                <Font size="18.0"/>
                            </font>
                        </TextField>

                        <PasswordField
                            promptText="Password">

                            <VBox.margin>
                                <Insets
                                    bottom="20.0"
                                    left="20.0"
                                    right="20.0"
                                    top="20.0"/>
                            </VBox.margin>

                            <font>
                                <Font size="18.0"/>
                            </font>
                        </PasswordField>

                        <Button
                            alignment="CENTER"
                            contentDisplay="CENTER"
                            graphicTextGap="5.0"
                            mnemonicParsing="false"
                            prefHeight="40.0"
                            prefWidth="142.0"
                            style="-fx-border-color: #2b3043;
                                   -fx-border-radius: 20;
                                   -fx-background-radius: 20;"
                            text="Log In"
                            textAlignment="CENTER">

                            <font>
                                <Font size="18.0"/>
                            </font>

                            <VBox.margin>
                                <Insets
                                    bottom="20.0"
                                    left="20.0"
                                    right="20.0"
                                    top="20.0"/>
                            </VBox.margin>
                        </Button>
                    </children>

                    <padding>
                        <Insets
                            bottom="20.0"
                            left="10.0"
                            right="10.0"
                            top="20.0"/>
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
