<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group1.bookit.PrimaryController" fx:id="loginRoot"
           prefWidth="1040.0" prefHeight="700.0" minWidth="0.0" minHeight="0.0"
           styleClass="login-root" stylesheets="@login.css">
    <fx:define>
        <Image fx:id="bookitLogoImage" url="@images/logo2.png"/>
    </fx:define>
    <children>
        <HBox id="loginCard" minWidth="0.0" minHeight="0.0" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="login-split">
            <children>
                <StackPane fx:id="loginBranding" minHeight="0.0" styleClass="login-brand-panel">
                    <clip><Rectangle fx:id="brandingClip"/></clip>
                    <children>
                        <Pane managed="false" mouseTransparent="true" pickOnBounds="false">
                            <children>
                                <Line startX="-140.0" startY="450.0" endX="1050.0" endY="-110.0" styleClass="login-brand-line"/>
                                <Line startX="-110.0" startY="520.0" endX="1090.0" endY="-40.0" styleClass="login-brand-line"/>
                                <Line startX="-80.0" startY="590.0" endX="1130.0" endY="30.0" styleClass="login-brand-line"/>
                                <Circle centerX="-155.0" centerY="245.0" radius="500.0" styleClass="login-brand-orbit"/>
                                <Circle centerX="-155.0" centerY="245.0" radius="565.0" styleClass="login-brand-orbit"/>
                                <Circle centerX="-155.0" centerY="245.0" radius="630.0" styleClass="login-brand-orbit"/>
                            </children>
                        </Pane>
                        <Pane minWidth="0.0" minHeight="0.0">
                            <children>
                                <ImageView fx:id="loginLogo" image="$bookitLogoImage" fitWidth="120.0" fitHeight="112.0"
                                           layoutX="${loginBranding.width * 0.18}" layoutY="${loginBranding.height * 0.08}"
                                           preserveRatio="true" smooth="true"/>
                                <VBox layoutX="${loginBranding.width * 0.18}" layoutY="${loginBranding.height * 0.30}"
                                      prefWidth="${loginBranding.width * 0.70}" styleClass="login-brand-copy-group">
                                    <children>
                                        <Label text="Hello,&#10;BookIt!" wrapText="true" minHeight="-Infinity" styleClass="login-brand-heading"/>
                                        <Label text="Find your next read, keep track of your books, and make the most of every library visit."
                                               maxWidth="400.0" wrapText="true" minHeight="-Infinity" styleClass="login-brand-copy"/>
                                    </children>
                                </VBox>
                                <Label text="YOUR LIBRARY, CONNECTED" layoutX="${loginBranding.width * 0.18}"
                                       layoutY="${loginBranding.height - 54}" styleClass="login-brand-caption"/>
                            </children>
                        </Pane>
                    </children>
                </StackPane>
                <BorderPane id="loginFormPanel" minWidth="0.0" minHeight="0.0" HBox.hgrow="ALWAYS" styleClass="login-form-panel">
                    <top>
                        <HBox id="loginWordmark" alignment="CENTER_LEFT" spacing="12.0" styleClass="login-wordmark">
                            <children>
                                <ImageView fx:id="compactLogo" image="$bookitLogoImage" fitWidth="50.0" fitHeight="48.0"
                                           visible="false" managed="false" preserveRatio="true" smooth="true"/>
                                <HBox alignment="CENTER_LEFT" spacing="0.0">
                                    <children>
                                        <Label text="Book" styleClass="login-wordmark-blue"/>
                                        <Label text="IT" styleClass="login-wordmark-orange"/>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </top>
                    <center>
                        <StackPane minWidth="0.0" minHeight="0.0" styleClass="login-form-center">
                            <children>
                                <VBox maxWidth="370.0" minWidth="0.0" alignment="CENTER_LEFT" styleClass="login-form">
                                    <children>
                                        <VBox spacing="6.0" minWidth="0.0">
                                            <children>
                                                <Label text="Welcome back!" minHeight="-Infinity" styleClass="login-heading"/>
                                                <Label text="Sign in to your library account." wrapText="true" minHeight="-Infinity" styleClass="login-subheading"/>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="login-fields">
                                            <children>
                                                <VBox styleClass="login-field">
                                                    <children>
                                                        <Label text="Username" styleClass="login-field-label"/>
                                                        <TextField fx:id="usernameField" promptText="Enter your username" accessibleText="Username" styleClass="login-input"/>
                                                    </children>
                                                </VBox>
                                                <VBox styleClass="login-field">
                                                    <children>
                                                        <Label text="Password" styleClass="login-field-label"/>
                                                        <PasswordField fx:id="passwordField" promptText="Enter your password" accessibleText="Password" styleClass="login-input"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <Label fx:id="loginMessageLabel" text="" minHeight="48.0" prefHeight="48.0" maxWidth="Infinity"
                                               wrapText="true" styleClass="login-message"/>
                                        <VBox styleClass="login-actions">
                                            <children>
                                                <Button id="loginQrButton" text="Start QR Reader" onAction="#openQrReader"
                                                        mnemonicParsing="false" maxWidth="Infinity" styleClass="login-qr-button"/>
                                                <Button id="loginSubmitButton" text="Log In" onAction="#handleLogin" defaultButton="true"
                                                        mnemonicParsing="false" maxWidth="Infinity" styleClass="login-submit-button"/>
                                            </children>
                                        </VBox>
                                        <Label fx:id="loginFooter" text="For library members and administrators." wrapText="true"
                                               minHeight="-Infinity" styleClass="login-footer"/>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </center>
                </BorderPane>
            </children>
        </HBox>
    </children>
</StackPane>
